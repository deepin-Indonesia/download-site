---
import Layout from '@/components/Layout.astro';
---

<Layout title="Halaman Tidak Ditemukan">
  <section class="min-h-[70vh] flex items-center justify-center py-20">
    <div class="text-center container-main">
      <div class="text-8xl font-extrabold text-gray-200 mb-4">404</div>
      <h1 class="text-3xl font-extrabold text-gray-900 mb-3">Ups! Halaman Tidak Ditemukan</h1>
      <p class="text-gray-500 max-w-md mx-auto mb-8">Halaman yang kamu cari tidak tersedia.</p>
      <a href="https://deepin.id" class="btn-primary">
        <i class="fas fa-arrow-left" /> Kembali ke deepin.id
      </a>
    </div>
  </section>
</Layout>
