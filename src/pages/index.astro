      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.2.0-riscv64.iso.torrent', sub: 'P2P download' },
      { name: 'GitHub', icon: 'fa-brands fa-github', url: 'https://deepin-community.github.io/sig-deepin-ports/images/riscv64', sub: 'Community ports' },
    ],
    sha256: 'ea5266d13a640eabc3b4cb7b893097a6416c5d457ae10bbd6bde0fc94e3ebe4a',
