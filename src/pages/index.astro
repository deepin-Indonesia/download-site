---
import Layout from '@/components/Layout.astro';

const arches = [
  {
    id: 'amd64', label: 'AMD64', sub: 'x86_64', active: true, desc: 'Untuk prosesor Intel & AMD — kebanyakan PC/laptop modern',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.2.0/amd64/deepin-desktop-community-25.2.0-amd64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.2.0-amd64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.2.0/amd64/deepin-desktop-community-25.2.0-amd64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1xIlYaWjJf84t5fkUnt7Qgg?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1syltXVAOe3T6qVy_ZSgjCqrOzPEwxkC8?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: 'f875c9a605bfe6a8425d1d353a3c1ec755bf37f5b0a3231ca19e2145da0ff450',
    md5: '3a4aa859ea72034dfb65805941fac372',
    iso: 'deepin-desktop-community-25.2.0-amd64.iso',
  },
  {
    id: 'arm64', label: 'ARM64', sub: 'aarch64', desc: 'Untuk perangkat ARM — Apple Silicon, Raspberry Pi 4/5, Snapdragon X',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.2.0/arm64/deepin-desktop-community-25.2.0-arm64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.2.0-arm64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.2.0/arm64/deepin-desktop-community-25.2.0-arm64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1XE2v3hVavr9KUj4c0iI_qA?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1fdIrL7YasF-YM8m4YYQTGfRJiqKMa2_4?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: '7c5cb76cec53532313f2b1f435d477a651f9b5f7ca2435dfc12eb7be8d3340fe',
    md5: 'db36fe803a2f0492af1521bb87a0037f',
    iso: 'deepin-desktop-community-25.2.0-arm64.iso',
  },
  {
    id: 'loong64', label: 'LoongArch', sub: 'loong64', desc: 'Untuk prosesor Loongson — arsitektur Tiongkok',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.2.0/loong64/deepin-desktop-community-25.2.0-loong64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.2.0-loong64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.2.0/loong64/', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1xIlYaWjJf84t5fkUnt7Qgg?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1fdIrL7YasF-YM8m4YYQTGfRJiqKMa2_4?usp=sharing', sub: 'Folder mirror' },
    ],
    iso: 'deepin-desktop-community-25.2.0-loong64.iso',
  },
  { id: 'riscv', label: 'RISC-V', sub: 'Preview', desc: 'Arsitektur masa depan — dukungan preview' },
  { id: 'wsl', label: 'WSL', sub: 'Windows', desc: 'Untuk Windows Subsystem for Linux' },
];

const active = arches.find(a => a.active) || arches[0];
---

<Layout title="Download deepin 25" description="Unduh deepin Linux 25.2.0 untuk berbagai arsitektur. deepin adalah distribusi Linux modern dengan DDE 7.0 yang cantik dan mudah digunakan.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-slate-800 to-deepin-900 py-16 lg:py-24">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(26,109,212,0.15)_0%,transparent_50%)]" />
    <div class="container-main relative text-center">
      <img src="/images/deepin-id.png" alt="deepin" width="96" height="96" class="w-24 h-24 mx-auto mb-5 drop-shadow-xl" />
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white">
        Download <span class="text-deepin-400">deepin</span>
      </h1>
      <p class="mt-3 text-deepin-200 text-lg">Unduh deepin Linux — Sistem Operasi Modern & Cantik</p>
    </div>
  </section>

  <!-- Headline Banner -->
  <section class="py-6 bg-deepin-50 border-b border-deepin-100">
    <div class="container-main flex flex-col sm:flex-row items-center justify-center gap-2 text-center">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-deepin-600 text-white text-xs font-semibold">
        <i class="fas fa-bullhorn text-[10px]" /> RILIS TERBARU
      </span>
      <p class="text-sm text-deepin-800 font-medium">
        deepin 25.2.0 kini tersedia! Peningkatan signifikan di Treeland, UOS AI, dan performa.
      </p>
      <a href="https://news.deepin.id/2026/07/08/deepin-25-2-release/" class="text-sm text-deepin-600 font-semibold hover:underline whitespace-nowrap">
        Baca selengkapnya <i class="fas fa-arrow-right text-[10px] ml-0.5" />
      </a>
    </div>
  </section>

  <!-- Version & Tabs -->
  <section class="py-12 bg-white">
    <div class="container-main">
      <div class="text-center mb-8">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-deepin-50 text-deepin-700 text-xs font-semibold tracking-wide uppercase">
          <i class="fas fa-star text-[10px]" /> Latest Release
        </span>
        <h2 class="text-3xl font-extrabold text-gray-900 mt-3">
          <span class="text-deepin-600">25.2.0</span>
        </h2>
        <p class="text-gray-500 mt-1">Pilih arsitektur yang sesuai dengan perangkat Anda</p>
      </div>

      <!-- Arch Tabs -->
      <div class="flex flex-wrap justify-center gap-2 mb-8" id="arch-tabs">
        {arches.map((a) => (
          <button
            class={`arch-tab px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-200 ${
              a.active ? 'bg-deepin-600 text-white shadow-lg shadow-deepin-600/25' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
            }`}
            data-arch={a.id}
          >
            {a.label}
            {a.sub && <span class="ml-1.5 text-[10px] opacity-60">{a.sub}</span>}
          </button>
        ))}
      </div>

      <!-- Arch Panels -->
      {arches.map((arch) => (
        <div id={`panel-${arch.id}`} class={`arch-panel ${arch.active ? '' : 'hidden'}`}>
          {arch.mirrors ? (
            <>
              <p class="text-center text-sm text-gray-500 mb-6">{arch.desc}</p>
              <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-3 mb-8">
                {arch.mirrors.map((m) => (
                  <a href={m.url} target="_blank" rel="noopener" class="card p-4 group hover:-translate-y-1 transition-all duration-300 text-center">
                    <i class={`fas ${m.icon.startsWith('fa-brands') ? m.icon : `fa-solid ${m.icon}`} text-xl text-deepin-600 mb-2`} />
                    <h3 class="font-semibold text-gray-900 text-sm">{m.name}</h3>
                    {m.sub && <p class="text-[10px] text-gray-400 mt-0.5">{m.sub}</p>}
                    <span class="text-xs text-deepin-600 mt-2 inline-flex items-center gap-1 group-hover:underline">
                      Download <i class="fas fa-arrow-right text-[10px]" />
                    </span>
                  </a>
                ))}
              </div>
              {arch.sha256 && (
                <details class="card p-5 max-w-3xl mx-auto text-sm mb-6">
                  <summary class="cursor-pointer font-semibold text-gray-700 hover:text-deepin-600 transition-colors">
                    <i class="fas fa-shield-halved mr-2 text-deepin-500" /> Verifikasi ISO
                  </summary>
                  <div class="mt-4 space-y-3 text-gray-600">
                    <div class="grid sm:grid-cols-2 gap-3">
                      <div class="bg-gray-50 rounded-lg p-3">
                        <span class="font-mono text-[10px] font-bold text-gray-400 uppercase">SHA256</span>
                        <pre class="mt-1 text-[11px] font-mono break-all whitespace-pre-wrap">{arch.sha256}</pre>
                      </div>
                      <div class="bg-gray-50 rounded-lg p-3">
                        <span class="font-mono text-[10px] font-bold text-gray-400 uppercase">MD5</span>
                        <pre class="mt-1 text-[11px] font-mono break-all whitespace-pre-wrap">{arch.md5}</pre>
                      </div>
                    </div>
                    <div class="bg-deepin-50 rounded-lg p-3 text-xs space-y-2">
                      <p class="font-semibold text-deepin-700"><i class="fas fa-terminal mr-1" />Copy-paste & jalankan di terminal:</p>
                      <div class="bg-white rounded p-2 font-mono text-[11px] text-deepin-800 break-all">
                        echo "{arch.sha256} *{arch.iso}" | shasum -a 256 --check
                      </div>
                      <p class="text-deepin-600">✅ <strong>OK</strong> = file asli, aman. ❌ <strong>FAILED</strong> = file rusak, download ulang.</p>
                    </div>
                  </div>
                </details>
              )}
            </>
          ) : (
            <div class="card p-10 text-center max-w-lg mx-auto">
              <i class="fas fa-clock text-4xl text-gray-300 mb-4" />
              <h3 class="font-bold text-gray-700 text-lg">Segera Hadir</h3>
              <p class="text-gray-500 text-sm mt-1">Dukungan arsitektur {arch.label} sedang dalam pengembangan.</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Help CTA -->
  <section class="py-12 bg-gray-50">
    <div class="container-main text-center">
      <i class="fas fa-circle-question text-3xl text-deepin-300 mb-4" />
      <h3 class="text-xl font-bold text-gray-900 mb-2">Butuh bantuan instalasi?</h3>
      <p class="text-gray-500 mb-6">Komunitas kami siap membantu kamu di Telegram.</p>
      <a href="https://t.me/Linux_deepin_ID" target="_blank" rel="noopener" class="btn-primary">
        <i class="fab fa-telegram-plane" /> Tanya di Telegram
      </a>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.arch-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const arch = tab.dataset.arch!;
      document.querySelectorAll('.arch-tab').forEach(t => t.classList.remove('bg-deepin-600', 'text-white', 'shadow-lg', 'shadow-deepin-600/25'));
      tab.classList.add('bg-deepin-600', 'text-white', 'shadow-lg', 'shadow-deepin-600/25');
      document.querySelectorAll('.arch-panel').forEach(p => p.classList.add('hidden'));
      document.getElementById(`panel-${arch}`)?.classList.remove('hidden');
    });
  });
</script>
