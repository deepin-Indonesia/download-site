      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.2.0-amd64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.2.0/amd64/deepin-desktop-community-25.2.0-amd64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1xIlYaWjJf84t5fkUnt7Qgg?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1syltXVAOe3T6qVy_ZSgjCqrOzPEwxkC8?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: 'f875c9a605bfe6a8425d1d353a3c1ec755bf37f5b0a3231ca19e2145da0ff450',
    md5: '3a4aa859ea72034dfb65805941fac372',
    iso: 'deepin-desktop-community-25.2.0-amd64.iso',
  },
  {
    id: 'arm64', label: 'ARM64', sub: 'aarch64',
    desc: 'Untuk perangkat ARM — Apple Silicon, Raspberry Pi 4/5, Snapdragon X',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.2.0/arm64/deepin-desktop-community-25.2.0-arm64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.2.0-arm64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.2.0/arm64/deepin-desktop-community-25.2.0-arm64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1XE2v3hVavr9KUj4c0iI_qA?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1fdIrL7YasF-YM8m4YYQTGfRJiqKMa2_4?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: '7c5cb76cec53532313f2b1f435d477a651f9b5f7ca2435dfc12eb7be8d3340fe',
    md5: 'db36fe803a2f0492af1521bb87a0037f',
    iso: 'deepin-desktop-community-25.2.0-arm64.iso',
  },
  {
    id: 'loong64', label: 'LoongArch', sub: 'loong64',
    desc: 'Untuk prosesor Loongson — arsitektur buatan Tiongkok',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.2.0/loong64/deepin-desktop-community-25.2.0-loong64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.2.0-loong64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.2.0/loong64/deepin-desktop-community-25.2.0-loong64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1Fun9ta2VG33qT8u4nvYCGw?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1-sOdShGZ-gT1peN9WmgM6m-q2rlwPT05?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: '1835726765d5839481572dbdaf8b8fdb5b2403ed8395cbe06f8d509891fb46c1',
