---
import { Image } from 'astro:assets';
import Layout from '@/components/Layout.astro';
import heroImg from '../assets/images/deepin-id.png';

interface Mirror {
  name: string; icon: string; url: string; sub: string;
}
interface Arch {
  id: string; label: string; sub: string; active?: boolean;
  desc: string; mirrors: Mirror[];
  sha256?: string; md5?: string; iso?: string;
}

const arches: Arch[] = [
  {
    id: 'amd64', label: 'AMD64', sub: 'x86_64', active: true,
    desc: 'Untuk prosesor Intel & AMD',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.3.0/amd64/deepin-desktop-community-25.3.0-amd64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.3.0-amd64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.3.0/amd64/deepin-desktop-community-25.3.0-amd64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/11pbOw8xZC5Kg7BRV2mjAng?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1Cwutb2MWMQXMt2Co7FWsgVgTKEky1yzu?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: '580b40c25ab5c437581db27dbd0fa3157499145e76dfcfefa0ec3c69ff3fe4ef',
    md5: '6e93f1b281a0b72d753087c79c21ed67',
    iso: 'deepin-desktop-community-25.3.0-amd64.iso',
  },
  {
    id: 'arm64', label: 'ARM64', sub: 'aarch64',
    desc: 'Untuk perangkat ARM',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.3.0/arm64/deepin-desktop-community-25.3.0-arm64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.3.0-arm64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.3.0/arm64/deepin-desktop-community-25.3.0-arm64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1iFsKP7rxU8IgJVkWF34yUA?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1OME8Tzq4vrHU5KxmLi2hdYS6TdgL8IvO?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: '8ebedac44fdbc408183f4acbdf9243abdf683e760698dbbe66bef87574ee6f3a',
    md5: '6876024b66271634d93b98ed35f03ae9',
    iso: 'deepin-desktop-community-25.3.0-arm64.iso',
  },
  {
    id: 'loong64', label: 'LoongArch', sub: 'loong64',
    desc: 'Untuk prosesor Loongson',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.3.0/loong64/deepin-desktop-community-25.3.0-loong64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.3.0-loong64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.3.0/loong64/deepin-desktop-community-25.3.0-loong64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1U_hRkXSM764fLbBsT8ff9A?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/13nrBKLarSZxNDswN4xUmh4rKJPWWxlqH?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: '940d5da9d58e27f5b005d0a5a2450c6e1724f6f06322b6f332d69023df35736b',
    md5: 'f5b5d9f1bad1839d75d4eab72b173cf8',
    iso: 'deepin-desktop-community-25.3.0-loong64.iso',
  },
  {
    id: 'riscv', label: 'RISC-V', sub: 'Preview',
    desc: 'Untuk perangkat RISC-V',
    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.3.0/riscv64/deepin-desktop-community-25.3.0-riscv64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.3.0-riscv64.iso.torrent', sub: 'P2P download' },
      { name: 'GitHub', icon: 'fa-brands fa-github', url: 'https://deepin-community.github.io/sig-deepin-ports/images/riscv64', sub: 'Community ports' },
    ],
    sha256: 'ddb1c5a62bac0cb57fb279a47f3a3460f7aa7465395b963a46c745a409a9a1c5',
    md5: 'b12118138799370f422fd40b5dbe7168',
    iso: 'deepin-desktop-community-25.3.0-riscv64.iso',
  },
  {
    id: 'wsl', label: 'WSL', sub: 'Windows',
    desc: 'Untuk Windows Subsystem for Linux',
    mirrors: [
      { name: 'GitHub Release', icon: 'fa-brands fa-github', url: 'https://github.com/deepin-community/deepin-WSL/releases/tag/v1.6.0', sub: 'Resmi — amd64 & arm64' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1NL0JHAs9S834zL1_g1Zjr6qAjD3_iL9f?usp=sharing', sub: 'Mirror — amd64 & arm64' },
    ],
  },
];
---

<Layout title="Download deepin 25" description="Unduh deepin Linux 25.3.0 untuk berbagai arsitektur — AMD64, ARM64, Loong64, RISC-V, dan WSL. Gratis dan open source.">
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-slate-800 to-deepin-900 py-16 lg:py-24">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(26,109,212,0.15)_0%,transparent_50%)]" />
    <div class="container-main relative text-center">
      <Image src={heroImg} alt="deepin" width={96} height={96} class="w-24 h-24 mx-auto mb-5 drop-shadow-xl" loading="eager" decoding="async" fetchpriority="high" />
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white">Download <span class="text-deepin-400">deepin</span></h1>
      <p class="mt-3 text-deepin-200 text-lg">Unduh deepin Linux — Sistem Operasi Modern & Cantik</p>
    </div>
  </section>

  <!-- Headline -->
  <section class="py-6 bg-deepin-50 border-b border-deepin-100">
    <div class="container-main flex flex-col sm:flex-row items-center justify-center gap-2 text-center">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-deepin-600 text-white text-xs font-semibold"><i class="fas fa-bullhorn text-[10px]" /> RILIS TERBARU</span>
      <p class="text-sm text-deepin-800 font-medium">deepin 25.3.0 kini tersedia! Freeze protection, UOS AI Agent, dan kernel 6.6.159.</p>
      <a href="https://news.deepin.id/2026-11-11-deepin-25-3-release/" class="text-sm text-deepin-600 font-semibold hover:underline whitespace-nowrap">Baca selengkapnya <i class="fas fa-arrow-right text-[10px] ml-0.5" /></a>
    </div>
  </section>

  <!-- Version & Tabs -->
  <section class="py-12 bg-white">
    <div class="container-main">
      <div class="text-center mb-8">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-deepin-50 text-deepin-700 text-xs font-semibold tracking-wide uppercase"><i class="fas fa-star text-[10px]" /> Rilis Terbaru</span>
        <h2 class="text-3xl font-extrabold text-gray-900 mt-3"><span class="text-deepin-600">25.3.0</span></h2>
        <p class="text-gray-500 mt-1">Pilih arsitektur yang sesuai dengan perangkat Anda</p>
      </div>

      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {arches.map((a) => (
          <button class={`arch-tab px-5 py-2.5 rounded-full text-sm font-semibold ${a.active ? 'shadow-lg shadow-deepin-600/25 cursor-default' : 'bg-gray-100 text-gray-600 hover:bg-gray-200 cursor-pointer'}`} data-arch={a.id} style={a.active ? 'background-color:#1a6dd4;color:#fff' : ''}>
            {a.label} <span class="ml-1.5 text-[10px] opacity-60">{a.sub}</span>
          </button>
        ))}
      </div>

      {arches.map((arch) => (
        <div id={`panel-${arch.id}`} class={`arch-panel ${arch.active ? '' : 'hidden'}`}>
          <p class="text-center text-sm text-gray-500 mb-6">{arch.desc}</p>

          {/* auto-fit + minmax: kolom menyusut di layar sempit (anti overflow horizontal)
              dan tetap maksimal 176px serta terpusat di layar lebar. */}
          <div class="grid justify-center gap-3 mb-8 grid-cols-[repeat(auto-fit,minmax(150px,176px))]">
            {arch.mirrors.map((m) => (
              <a href={m.url} target="_blank" rel="noopener" class="card p-4 group hover:-translate-y-1 transition-all duration-300 text-center flex flex-col items-center justify-center gap-2 h-40">
                <i class={`fas ${m.icon.startsWith('fa-brands') ? m.icon : `fa-solid ${m.icon}`} text-xl text-deepin-600 mb-2`} />
                <h3 class="font-semibold text-gray-900 text-sm">{m.name}</h3>
                <p class="text-[10px] text-gray-400 mt-0.5">{m.sub}</p>
                <span class="text-xs text-deepin-600 mt-2 group-hover:underline">Download <i class="fas fa-arrow-right text-[10px]" /></span>
              </a>
            ))}
          </div>

          {arch.id === 'wsl' && (
            <div class="card max-w-3xl mx-auto p-6 text-center mt-4 bg-gradient-to-br from-deepin-50 to-white border-2 border-deepin-100">
              <i class="fas fa-book-open text-3xl text-deepin-500 mb-3" />
              <h3 class="font-bold text-gray-900 text-lg mb-2">Panduan Instalasi WSL</h3>
              <p class="text-sm text-gray-500 mb-4">Bingung cara install deepin di WSL? Ikuti tutorial langkah demi langkah yang sudah kami siapkan.</p>
              <a href="https://news.deepin.id/2026-08-04-tutorial-install-deepin-wsl" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-deepin-600 text-white text-sm font-semibold hover:bg-deepin-700 transition-all hover:-translate-y-0.5 shadow-md">
                <i class="fas fa-arrow-right text-xs" /> Baca Tutorial Lengkap
              </a>
            </div>
          )}

          {arch.sha256 && (
            <details class="faq-item max-w-3xl mx-auto">
              <summary>
                <span><i class="fas fa-shield-halved mr-2 text-deepin-500" aria-hidden="true" /> Verifikasi ISO</span>
              </summary>
              <div class="pt-4 space-y-6">
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">SHA256</p>
                    <pre class="bg-gray-50 rounded-lg p-3 text-[11px] font-mono text-gray-700 break-all whitespace-pre-wrap leading-relaxed">{arch.sha256}</pre>
                  </div>
                  <div>
                    <p class="text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">MD5</p>
                    <pre class="bg-gray-50 rounded-lg p-3 text-[11px] font-mono text-gray-700 break-all whitespace-pre-wrap leading-relaxed">{arch.md5}</pre>
                  </div>
                </div>

                <div class="bg-deepin-50 rounded-xl p-5">
                  <p class="font-semibold text-deepin-800 mb-3 text-xs flex items-center gap-1.5">
                    <i class="fas fa-terminal text-deepin-500" /> Verifikasi via Terminal
                  </p>
                  <div class="space-y-3">
                    <div class="bg-white rounded-lg p-3 font-mono text-[11px]">
                      <p class="text-[10px] text-gray-400 mb-1 font-semibold">SHA256 (disarankan)</p>
                      <code class="text-deepin-800 break-all">echo "{arch.sha256} *{arch.iso}" | shasum -a 256 --check</code>
                    </div>
                    <div class="bg-white rounded-lg p-3 font-mono text-[11px]">
                      <p class="text-[10px] text-gray-400 mb-1 font-semibold">MD5</p>
                      <code class="text-deepin-800 break-all">echo "{arch.md5} *{arch.iso}" | md5sum --check</code>
                    </div>
                  </div>
                  </div>
                  <div class="mt-4 bg-green-50 border border-green-100 rounded-lg p-3 flex items-center gap-2 text-[11px]">
                    <i class="fas fa-check-circle text-green-500" />
                    <span class="font-mono text-green-700">Output yang benar: <strong>{arch.iso}: OK</strong></span>
                  </div>
                  <p class="text-[11px] text-deepin-600 mt-3">
                    ✅ <strong>OK</strong> = file asli, aman digunakan &nbsp;|&nbsp;
                    ❌ <strong>FAILED</strong> = file rusak, download ulang
                  </p>

                <!-- Alt commands section -->
                <div class="border-t border-gray-200 pt-6 mt-2">
                  <details class="faq-item">
                    <summary>Perintah alternatif (Linux / Windows / macOS)</summary>
                    <p class="text-[11px] text-gray-400 mt-4">Jalankan lalu <strong>bandingkan output hash-nya — harus sama persis.</strong></p>
                    <div class="space-y-1.5 text-[11px]">
                      {[
                        { os: 'Linux', icon: 'fa-brands fa-linux', cmd: `sha256sum ${arch.iso}` },
                        { os: 'Linux', icon: 'fa-brands fa-linux', cmd: `md5sum ${arch.iso}` },
                        { os: 'Windows PS', icon: 'fa-brands fa-windows', cmd: `Get-FileHash .\\${arch.iso} -Algorithm SHA256` },
                        { os: 'Windows PS', icon: 'fa-brands fa-windows', cmd: `Get-FileHash .\\${arch.iso} -Algorithm MD5` },
                        { os: 'macOS', icon: 'fa-brands fa-apple', cmd: `shasum -a 256 ${arch.iso}` },
                        { os: 'macOS', icon: 'fa-brands fa-apple', cmd: `md5 ${arch.iso}` },
                      ].map((alt) => (
                        <div class="flex items-center gap-2 bg-white rounded px-3 py-1.5">
                          <i class={`${alt.icon} text-gray-400 w-4 text-center`} />
                          <code class="font-mono text-gray-700 break-all">{alt.cmd}</code>
                        </div>
                      ))}
                    </div>
                  </details>
                </div>
              </div>
            </details>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="py-12 bg-gray-50">
    <div class="container-main text-center">
      <i class="fas fa-circle-question text-3xl text-deepin-300 mb-4" />
      <h3 class="text-xl font-bold text-gray-900 mb-2">Butuh bantuan instalasi?</h3>
      <p class="text-gray-500 mb-6">Komunitas deepin Indonesia siap membantu kamu.</p>
      <a href="https://t.me/Linux_deepin_ID" target="_blank" rel="noopener" class="btn-primary"><i class="fab fa-telegram-plane" /> Tanya di Komunitas</a>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('.arch-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const arch = tab.dataset.arch!;
      document.querySelectorAll('.arch-tab').forEach(t => {
        t.classList.remove('shadow-lg','shadow-deepin-600/25','cursor-default');
        t.classList.add('bg-gray-100','text-gray-600','cursor-pointer');
        t.removeAttribute('style');
      });
      tab.classList.remove('bg-gray-100','text-gray-600','cursor-pointer');
      tab.classList.add('shadow-lg','shadow-deepin-600/25','cursor-default');
      tab.setAttribute('style','background-color:#1a6dd4;color:#fff');
      document.querySelectorAll('.arch-panel').forEach(p => p.classList.add('hidden'));
      document.getElementById(`panel-${arch}`)?.classList.remove('hidden');
    });
  });
</script>
