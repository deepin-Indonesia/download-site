    mirrors: [
      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.2.0/arm64/deepin-desktop-community-25.2.0-arm64.iso', sub: 'CDN77 accelerated' },
      { name: 'Torrent', icon: 'fa-cloud-arrow-down', url: 'https://storage.deepin.org/static/v25/deepin-desktop-community-25.2.0-arm64.iso.torrent', sub: 'P2P download' },
      { name: 'SourceForge', icon: 'fa-server', url: 'https://sourceforge.net/projects/deepin/files/25.2.0/arm64/deepin-desktop-community-25.2.0-arm64.iso/download', sub: 'Mirror global' },
      { name: 'Baidu Cloud', icon: 'fa-cloud', url: 'https://pan.baidu.com/s/1XE2v3hVavr9KUj4c0iI_qA?pwd=deep', sub: 'pass: deep' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1fdIrL7YasF-YM8m4YYQTGfRJiqKMa2_4?usp=sharing', sub: 'Folder mirror' },
    ],
    sha256: '7c5cb76cec53532313f2b1f435d477a651f9b5f7ca2435dfc12eb7be8d3340fe',
    md5: 'db36fe803a2f0492af1521bb87a0037f',
    iso: 'deepin-desktop-community-25.2.0-arm64.iso',
  },
  {
    id: 'loong64', label: 'LoongArch', sub: 'loong64',
