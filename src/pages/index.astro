---
import Layout from '@/components/Layout.astro';

interface Mirror {
  name: string; icon: string; url: string; sub: string;
}
interface Arch {
  id: string; label: string; sub: string; active?: boolean;
  desc: string; mirrors: Mirror[];
  sha256?: string; md5?: string; iso?: string;
