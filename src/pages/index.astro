      { name: 'Direct Download', icon: 'fa-bolt', url: 'https://cdimage.deepin.com/releases/25.2.0/wsl/deepin-wsl-25.2.0-amd64.zip', sub: 'CDN77 accelerated' },
      { name: 'Google Drive', icon: 'fa-brands fa-google-drive', url: 'https://drive.google.com/drive/folders/1Y8Ix4K2QoTf_hSboQRD2_lZktXaFLQ--?usp=sharing', sub: 'Folder mirror' },
